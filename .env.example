# Host port for the portal, clients and the /play WebSocket proxy.
HTTP_PORT=80

# ---- Accounts ----
# Site Admin account created on first start. deploy/oracle/deploy.sh fills
# ADMIN_PASSWORD with a random value; read it with: grep ADMIN_PASSWORD .env
# Leave ADMIN_PASSWORD empty and the first account registered becomes Site Admin.
# Changing it later does not reset an existing account's password.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
# Signs play tokens. Empty = generated once and kept in the archive-data volume.
SESSION_SECRET=
# 1 = anyone can create an account; 0 = only the Site Admin adds users.
# (Site Admins can also change this in Access control > Settings.)
ALLOW_REGISTRATION=1
# Public address, used for the Google redirect URI and secure cookies.
# Example: PUBLIC_URL=https://203-0-113-7.sslip.io
# PUBLIC_URL=

# ---- Google sign-in (optional) ----
# Create an OAuth client ID (type "Web application") in Google Cloud Console and add
# the redirect URI  <PUBLIC_URL>/auth/google/callback . Then uncomment and fill in:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: only allow these email domains, comma separated (e.g. gmail.com,example.org)
# GOOGLE_ALLOWED_DOMAINS=
# Google-verified addresses that always get Site Admin, comma separated
# ADMIN_EMAILS=
